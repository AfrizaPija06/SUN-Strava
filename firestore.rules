rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Rules for the athletes collection
    // Since there is no Authentication implemented yet, we allow all reads and writes.
    // WARNING: This makes your data public to anyone who has your Firebase configuration.
    match /athletes/{athleteId} {
      allow read, write: if true;
    }
    
    // For the test connection
    match /test/connection {
      allow read: if true;
    }
  }
}
